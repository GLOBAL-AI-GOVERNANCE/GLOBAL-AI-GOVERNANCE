{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GLOBAL-AI-GOVERNANCE/GLOBAL-AI-GOVERNANCE/schemas/portfolio.schema.json",
  "title": "GLOBAL AI GOVERNANCE Portfolio Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner",
    "profile_repository",
    "flagship_repository",
    "shared_lifecycle",
    "repositories",
    "integration_contract_version",
    "development_candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "owner": {
      "const": "GLOBAL-AI-GOVERNANCE"
    },
    "profile_repository": {
      "const": "GLOBAL-AI-GOVERNANCE/GLOBAL-AI-GOVERNANCE"
    },
    "flagship_repository": {
      "type": "string",
      "minLength": 1
    },
    "shared_lifecycle": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "display_name",
          "lifecycle_roles",
          "version",
          "maturity",
          "finished_outcome",
          "authority_boundary",
          "upstream",
          "downstream"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle_roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "maturity": {
            "type": "string",
            "minLength": 1
          },
          "finished_outcome": {
            "type": "string",
            "minLength": 1
          },
          "authority_boundary": {
            "type": "string",
            "minLength": 1
          },
          "upstream": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "downstream": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "integration_contract_version": {
      "const": "1.0.0"
    },
    "development_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai-cyber-resilience-framework",
        "peace-os-crisis-room"
      ],
      "properties": {
        "ai-cyber-resilience-framework": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate",
            "status",
            "published_release"
          ],
          "properties": {
            "candidate": {
              "const": "v0.2.0 Continuous Assurance Thread"
            },
            "status": {
              "const": "MERGED_UNRELEASED"
            },
            "published_release": {
              "const": "v0.1.1"
            }
          }
        },
        "peace-os-crisis-room": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate",
            "status",
            "published_release"
          ],
          "properties": {
            "candidate": {
              "const": "Post-RC2 Portfolio Operating Disposition Reference"
            },
            "status": {
              "const": "MERGED_UNRELEASED"
            },
            "published_release": {
              "const": "v0.3.0-rc2"
            }
          }
        }
      }
    }
  }
}
